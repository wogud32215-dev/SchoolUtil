{
  "name": "schoolutil",
  "version": "1.0.5",
  "description": "SchoolUtil — Windows 바탕화면 종합 유틸",
  "main": "dist-electron/bootstrap.js",
  "author": "SchoolUtil",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/wogud32215-dev/SchoolUtil.git"
  },
  "bugs": {
    "url": "https://github.com/wogud32215-dev/SchoolUtil/issues"
  },
  "homepage": "https://github.com/wogud32215-dev/SchoolUtil#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:install": "node node_modules/electron/install.js",
    "electron:unblock": "node scripts/unblock-electron.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "clean:build": "rimraf dist dist-electron",
    "clean": "npm run clean:build && rimraf release",
    "prebuild": "npm run clean:build",
    "build": "node scripts/prepare-neis-shared.mjs && tsc -b && vite build && node scripts/copy-uia-scripts.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:staging": "npm run build && electron-builder --win --config.directories.output=release-staging",
    "dist:dir:staging": "npm run build && electron-builder --win --dir --config.directories.output=release-staging",
    "dist:publish": "npm run build && electron-builder --win --publish always",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource/pretendard": "^5.3.0",
    "chrome-remote-interface": "^0.34.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "iconv-lite": "^0.7.3",
    "koffi": "^2.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-resizable": "^3.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0",
    "rcedit": "^4.0.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.schoolutil.app",
    "productName": "SchoolUtil",
    "afterPack": "./scripts/after-pack.mjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "dist-electron/**/*.ps1"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/neis-shared.v1.bin",
        "to": "neis-shared.v1.bin"
      }
    ],
    "extraFiles": [
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "wogud32215-dev",
      "repo": "SchoolUtil",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@34.5.8": true
  }
}
