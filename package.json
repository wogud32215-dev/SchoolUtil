{
  "name": "schoolutil",
  "version": "0.4.0",
  "description": "SchoolUtil — Windows 바탕화면 종합 유틸",
  "main": "dist-electron/bootstrap.js",
  "author": "SchoolUtil",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/wogud32215-dev/SchoolUtil.git"
  },
  "bugs": {
    "url": "https://github.com/wogud32215-dev/SchoolUtil/issues"
  },
  "homepage": "https://github.com/wogud32215-dev/SchoolUtil#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean:build": "rimraf dist dist-electron",
    "clean": "npm run clean:build && rimraf release",
    "prebuild": "npm run clean:build",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:publish": "npm run build && electron-builder --win --publish always",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "koffi": "^2.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.schoolutil.app",
    "productName": "SchoolUtil",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "wogud32215-dev",
      "repo": "SchoolUtil",
      "releaseType": "release"
    }
  }
}
